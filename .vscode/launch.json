    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'producer'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=producer",
                    "--package=producer"
                ],
                "filter": {
                    "name": "producer",
                    "kind": "bin"
                },
                "env": {
                    "RUST_BACKTRACE": "1",
                    "MQSERVER": "DEV.ADMIN.SRVCONN/TCP/localhost(1414)"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'producer'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=producer",
                    "--package=producer"
                ],
                "filter": {
                    "name": "producer",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'consumer'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=consumer",
                    "--package=consumer"
                ],
                "filter": {
                    "name": "consumer",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'consumer'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=consumer",
                    "--package=consumer"
                ],
                "filter": {
                    "name": "consumer",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}